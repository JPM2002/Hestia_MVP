# Environment Variables for Hestia Dashboard

# API Mode: use mock data (true) or real backend (false)
VITE_USE_MOCKS=true

# Backend API base URL (only used when VITE_USE_MOCKS=false)
# Leave empty if using Vite proxy (recommended for development)
# Set to backend URL if proxy not configured: http://localhost:5000
VITE_API_BASE_URL=
